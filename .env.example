# Copy to .env.local and fill in. Never commit real values.

# Neon PostgreSQL connection string (CMS content; also read at build time)
DATABASE_URL=

# Admin sign-in
ADMIN_EMAIL=
# bcrypt hash from `npm run db:generate-hash <password>`.
# In shell-loaded env files, escape each $ as \$
ADMIN_PASSWORD_HASH=

# Signs the admin session. Required: sign-in refuses to work without it.
# Use 32+ random characters, e.g. `openssl rand -base64 32`
JWT_SECRET=

# Vercel Blob token for admin image uploads
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/* (scheduled publishing, blob clean-up). Vercel Cron
# sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Public base URL used in a few absolute links (optional locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
